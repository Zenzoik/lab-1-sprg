# Project-specific build rules layered on top of the CubeMX-generated Makefile.
#
# `Makefile` is regenerated by CubeMX from firmware.ioc and must not be edited.
# This file includes it and adds our own layers (Platform/, Devices/, App/);
# CubeMX never touches it, so regeneration cannot destroy this work.
#
# Usage: make -f Makefile.app all      (the repo-root Makefile does this in Docker)

include Makefile

# --- our layers -------------------------------------------------------------
APP_SOURCES := \
Platform/platform.c \
Devices/mpu6050.c \
Devices/w25q64.c \
App/motion.c \
App/app.c

C_SOURCES += $(APP_SOURCES)
vpath %.c Platform Devices App

# Vendor headers (ST HAL, CMSIS) are treated as system headers so that their
# warnings never mask warnings in our own code. Core/Inc stays a normal path.
C_INCLUDES := \
-ICore/Inc \
-IPlatform \
-IDevices \
-IApp \
-isystemDrivers/STM32C0xx_HAL_Driver/Inc \
-isystemDrivers/STM32C0xx_HAL_Driver/Inc/Legacy \
-isystemDrivers/CMSIS/Device/ST/STM32C0xx/Include \
-isystemDrivers/CMSIS/Include

# --- strict warnings for OUR code only ---------------------------------------
# CubeMX-generated files (Core/Src/*.c) and the vendor HAL keep the default -Wall.
APP_OBJECTS := $(addprefix $(BUILD_DIR)/,$(notdir $(APP_SOURCES:.c=.o)))
$(APP_OBJECTS): CFLAGS += -Wextra -Wshadow -Wpedantic -Werror

# The included Makefile expanded the elf prerequisites before our sources were appended,
# so declare the dependency of the link step on our objects explicitly.
$(BUILD_DIR)/$(TARGET).elf: $(APP_OBJECTS)
